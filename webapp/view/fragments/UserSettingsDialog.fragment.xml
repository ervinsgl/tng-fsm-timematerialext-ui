<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <!--
        UserSettingsDialog Fragment: the app's user settings, from the FSM UDO
        'TMExt_UserSettings'.

        TABLE 1 - "Available settings" (always first)
            One row per field of the UDO DEFINITION (UdoMeta.udfMetas), in FSM's
            own field order.
                Setting = the UDF's description
                Value   = a dropdown of the UDF's selectionKeyValues
                          (empty cell when the UDF has no selection list)
            Preselected with what the user saved last time, falling back to
            the field's default when they have saved nothing yet. The choice is
            kept in the model as `selectedValue` - that is what OK writes.

        TABLE 2 - the logged-in user's own saved record, when they have one
            Setting = the UDF's description, Value = the stored value.
            Records belonging to other people are filtered out in the backend,
            so they never reach the browser.

        No setting name is hardcoded: whatever the UDO carries in FSM is what
        gets rendered, so new settings need no app change.

        Replaces the former Type Configuration dialog on this button.
        TypeConfigDialog.fragment.xml is left in place, unreferenced, in case
        Expense/Mileage type configuration is needed again.

        Model: userSettings
    -->
    <Dialog
        id="userSettingsDialog"
        title="{i18n>userSettingsTitle}"
        contentWidth="42rem"
        contentHeight="32rem"
        draggable="true"
        resizable="true"
        verticalScrolling="true"
        busy="{userSettings>/busy}"
        busyIndicatorDelay="0"
    >
        <customHeader>
            <OverflowToolbar>
                <core:Icon src="sap-icon://action-settings"/>
                <ToolbarSpacer width="0.5rem"/>
                <Title text="{i18n>userSettingsTitle}" level="H4"/>
                <ToolbarSpacer/>
                <!-- At most one record (the logged-in user's own), so this is a
                     saved/not-saved indicator rather than a count. -->
                <ObjectStatus
                    text="{i18n>userSettingsSaved}"
                    state="Success"
                    icon="sap-icon://accept"
                    visible="{= ${userSettings>/recordCount} > 0 }"
                    class="sapUiTinyMarginEnd"/>
                <Button
                    icon="sap-icon://refresh"
                    type="Transparent"
                    tooltip="{i18n>userSettingsRefreshTooltip}"
                    press=".onRefreshUserSettings"/>
            </OverflowToolbar>
        </customHeader>

        <content>
            <VBox class="sapUiSmallMargin">

                <!-- Load error -->
                <MessageStrip
                    text="{i18n>userSettingsLoadFailed}"
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                    visible="{userSettings>/hasError}"/>

                <!-- ============================================================
                     TABLE 1: every possible setting (the UDO definition)
                     ============================================================ -->
                <Panel
                    expandable="true"
                    expanded="true"
                    class="sapUiSmallMarginBottom"
                    visible="{= ${userSettings>/fieldCount} > 0 }">
                    <headerToolbar>
                        <OverflowToolbar design="Info">
                            <core:Icon src="sap-icon://list" class="sapUiTinyMarginEnd"/>
                            <Title text="{i18n>userSettingsAvailableTitle}" level="H5"/>
                            <ToolbarSpacer/>
                            <!-- Free text maintained in FSM on the settings definition.
                                 Whatever is typed there is what the user reads. -->
                            <Text text="{userSettings>/definitionDescription}" class="sapUiTinyMarginEnd"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <Table
                            items="{path: 'userSettings>/fields', templateShareable: false}"
                            mode="None"
                            noDataText="{i18n>userSettingsNoFields}"
                            class="sapUiSizeCondensed">
                            <columns>
                                <Column width="30%" hAlign="Begin">
                                    <Text text="{i18n>userSettingsColSetting}"/>
                                </Column>
                                <Column width="40%" hAlign="Begin">
                                    <Text text="{i18n>userSettingsColValue}"/>
                                </Column>
                                <!-- What is actually in force right now: the value
                                     stored in this user's record. It sits beside the
                                     editable Value so the difference between "what I
                                     am about to save" and "what is saved" is visible
                                     in one row - which is what the second table used
                                     to show in a separate block.

                                     Pops in below the row on a phone rather than
                                     squeezing three columns into ~380px. -->
                                <Column hAlign="Begin"
                                        demandPopin="true"
                                        minScreenWidth="Tablet"
                                        popinDisplay="Inline">
                                    <Text text="{i18n>userSettingsColApplied}"/>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Inactive">
                                    <cells>
                                        <Text text="{userSettings>label}" wrapping="true"/>
                                        <!-- Value cell. Two renderings, one column:
                                             - SELECTIONLIST field -> dropdown of its options
                                             - anything else -> the plain value (for a PERSON
                                               field that is the logged-in user's externalId);
                                               blank when there is nothing to show.
                                             Free-text editing arrives with the PATCH.

                                             VBox, not HBox: a flex ROW child ignores
                                             width="100%" and collapses the Select to just its
                                             arrow. A VBox stretches its children by default. -->
                                        <VBox width="100%">
                                            <Select
                                                items="{path: 'userSettings>options', templateShareable: false}"
                                                selectedKey="{userSettings>selectedValue}"
                                                forceSelection="false"
                                                width="100%"
                                                visible="{= ${userSettings>options}.length > 0 }">
                                                <core:Item key="{userSettings>key}" text="{userSettings>text}"/>
                                            </Select>
                                            <!-- displayValue, not selectedValue: for a person
                                                 field the table shows "firstName lastName"
                                                 while selectedValue keeps the externalId that
                                                 the PATCH will write. -->
                                            <Text
                                                text="{userSettings>displayValue}"
                                                wrapping="true"
                                                visible="{= ${userSettings>options}.length === 0 }"/>
                                        </VBox>
                                        <!-- The stored value, already resolved to its
                                             readable form (a selection code shows as its
                                             text, a person externalId as the name).
                                             An en dash means this user has saved nothing
                                             for this setting yet - distinguishable from a
                                             setting saved as empty. -->
                                        <Text
                                            text="{= ${userSettings>savedDisplayValue} ? ${userSettings>savedDisplayValue} : '–' }"
                                            wrapping="true"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>

                <!-- Empty state: no stored records (or none readable) -->
                <IllustratedMessage
                    illustrationType="sapIllus-NoEntries"
                    title="{i18n>userSettingsEmptyTitle}"
                    description="{userSettings>/emptyDescription}"
                    visible="{= ${userSettings>/recordCount} === 0 &amp;&amp; ${userSettings>/hasError} !== true &amp;&amp; ${userSettings>/busy} !== true }"/>

                <!-- The separate "your saved settings" table that used to sit here
                     was removed: its one useful column is now the third column of
                     the table above (savedDisplayValue), so the stored value reads
                     on the same row as the setting it belongs to instead of in a
                     second block the user had to cross-reference. -->

            </VBox>
        </content>

        <!-- SAP footer convention: the primary action on the left (begin), the
             closing action on the right (end). OK writes the record for the
             logged-in user - creating it, or updating the one that already
             holds this person's externalId. -->
        <beginButton>
            <Button
                text="{i18n>userSettingsOk}"
                type="Emphasized"
                press=".onSaveUserSetting"
                enabled="{= ${userSettings>/fieldCount} > 0 }"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>userSettingsClose}" press=".onCloseUserSettings"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>